<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Engineering Material Inventory</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f8f9fa;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .summary {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.1em;
        }

        button {
            margin: 10px;
            padding: 10px 20px;
            font-size: 14px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th, td {
            border: 1px solid #dee2e6;
            padding: 8px;
            text-align: center;
        }

        th {
            background-color: #343a40;
            color: white;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            width: 400px;
        }

        .modal-content input, .modal-content button {
            margin: 10px 0;
            width: 100%;
            padding: 8px;
        }

        .modal-content label {
            display: block;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <h1>Engineering Material Inventory</h1>

    <div class="summary">
        <span id="totalItems">Total Materials: 0</span> |
        <span id="lastUpdated">Last updated: Never</span>
    </div>

    <button id="addMaterialBtn">Add Material</button>
    <button id="exportBtn">Export CSV</button>

    <table id="materialsTable">
        <thead>
            <tr>
                <th>Item No.</th>
                <th>Material Name</th>
                <th>Specifications</th>
                <th>In Stock</th>
                <th>Out Stock</th>
                <th>Balance</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div class="modal" id="materialModal">
        <div class="modal-content">
            <form id="materialForm">
                <input type="hidden" id="editItemId">
                <label>Item Number:</label>
                <input type="number" id="itemNumber" required>
                <label>Material Name:</label>
                <input type="text" id="materialName" required>
                <label>Specifications:</label>
                <input type="text" id="specifications" required>
                <label>In Stock:</label>
                <input type="number" id="inStock" required>
                <label>Out Stock:</label>
                <input type="number" id="outStock" required>
                <button type="submit">Save</button>
                <button type="button" onclick="closeModal()">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        let materials = JSON.parse(localStorage.getItem('engineeringMaterials')) || [];
        let nextItemNumber = materials.length ? Math.max(...materials.map(m => m.itemNumber)) + 1 : 1;

        document.addEventListener('DOMContentLoaded', () => {
            const tableBody = document.querySelector('#materialsTable tbody');
            const modal = document.getElementById('materialModal');
            const materialForm = document.getElementById('materialForm');

            function openModal(editData = null) {
                modal.style.display = 'flex';
                if (editData) {
                    document.getElementById('editItemId').value = editData.id;
                    document.getElementById('itemNumber').value = editData.itemNumber;
                    document.getElementById('materialName').value = editData.name;
                    document.getElementById('specifications').value = editData.specifications;
                    document.getElementById('inStock').value = editData.inStock;
                    document.getElementById('outStock').value = editData.outStock;
                } else {
                    materialForm.reset();
                    document.getElementById('editItemId').value = '';
                    document.getElementById('itemNumber').value = nextItemNumber;
                }
            }

            window.closeModal = () => {
                modal.style.display = 'none';
            };

            function renderTable() {
                tableBody.innerHTML = '';
                materials.forEach(material => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${material.itemNumber}</td>
                        <td>${material.name}</td>
                        <td>${material.specifications}</td>
                        <td>${material.inStock}</td>
                        <td>${material.outStock}</td>
                        <td>${material.inStock - material.outStock}</td>
                        <td>
                            <button onclick='editMaterial("${material.id}")'>Edit</button>
                            <button onclick='deleteMaterial("${material.id}")'>Delete</button>
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
            }

            window.editMaterial = (id) => {
                const material = materials.find(m => m.id === id);
                if (material) {
                    openModal(material);
                }
            };

            window.deleteMaterial = (id) => {
                if (confirm('Are you sure you want to delete this material?')) {
                    materials = materials.filter(m => m.id !== id);
                    localStorage.setItem('engineeringMaterials', JSON.stringify(materials));
                    renderTable();
                    updateSummary();
                }
            };

            document.getElementById('addMaterialBtn').addEventListener('click', () => openModal());
            document.getElementById('exportBtn').addEventListener('click', exportToCSV);

            function exportToCSV() {
                const headers = ['Item Number', 'Material Name', 'Specifications', 'In Stock', 'Out Stock', 'Balance'];
                const rows = [headers];

                materials.forEach(material => {
                    const row = [
                        material.itemNumber,
                        material.name,
                        material.specifications,
                        material.inStock,
                        material.outStock,
                        material.inStock - material.outStock
                    ];
                    rows.push(row);
                });

                const csvContent = rows.map(e => e.join(',')).join('\n');
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'materials.csv';
                link.click();
            }

            function updateSummary() {
                const totalItems = materials.length;
                const lastUpdated = new Date().toLocaleString();
                document.getElementById('totalItems').textContent = `Total Materials: ${totalItems}`;
                document.getElementById('lastUpdated').textContent = `Last updated: ${lastUpdated}`;
            }

            materialForm.addEventListener('submit', (event) => {
                event.preventDefault();

                const itemNumber = document.getElementById('itemNumber').value;
                const name = document.getElementById('materialName').value;
                const specifications = document.getElementById('specifications').value;
                const inStock = parseInt(document.getElementById('inStock').value);
                const outStock = parseInt(document.getElementById('outStock').value);
                const editItemId = document.getElementById('editItemId').value;

                if (editItemId) {
                    const index = materials.findIndex(m => m.id === editItemId);
                    materials[index] = {
                        id: editItemId,
                        itemNumber: parseInt(itemNumber),
                        name,
                        specifications,
                        inStock,
                        outStock
                    };
                } else {
                    materials.push({
                        id: Date.now().toString(),
                        itemNumber: parseInt(itemNumber),
                        name,
                        specifications,
                        inStock,
                        outStock
                    });
                    nextItemNumber++;
                }

                localStorage.setItem('engineeringMaterials', JSON.stringify(materials));
                renderTable();
                closeModal();
                updateSummary();
            });

            renderTable();
            updateSummary();
        });
    </script>
</body>
</html>
